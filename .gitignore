# Build and test output
/bin/
/dist/
*.exe
*.test
*.prof
/coverage.*
*.coverprofile

# Local development config and storage root (see deploy/config.example.toml).
# Never commit a storage root, a database, or secrets.
/dev/
*.local.toml

# Go workspace files (single module, ADR-0004)
go.work
go.work.sum

# Web UI dependencies and build output (S02). web/build/ keeps its .gitkeep so
# that go:embed (web/embed.go) works without a UI build.
node_modules/
/web/.svelte-kit/
/web/build/*
!/web/build/.gitkeep
/web/src/lib/generated/
# Copied from pdfjs-dist by web/scripts/pdfjs-assets.mjs before dev and build (S02.6-T04).
/web/static/pdfjs/

# Editors and operating systems
.idea/
*.swp
.DS_Store
Thumbs.db
