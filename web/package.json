{
  "name": "local-ai-nas-web",
  "version": "0.0.0",
  "private": true,
  "description": "The local-ai-nas web interface (S02), embedded in the core binary.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node -e \"require('node:fs').writeFileSync('build/.gitkeep', '')\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@sveltejs/kit": "2.70.3",
    "svelte": "5.57.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1"
  }
}
