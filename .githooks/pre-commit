#!/bin/sh
# Blocks a commit whose staged changes contain a secret (S03.5-T07; the
# user's decision D3). Turned on by scripts/install-git-hooks.sh (or .ps1).
# Never bypass it with --no-verify (RULES R15). A false positive gets a
# narrow, explained entry in .gitleaks.toml in its own reviewed commit.
set -eu
root="$(git rev-parse --show-toplevel)"
. "$root/.githooks/find-gitleaks.sh"
exec "$GITLEAKS" git --pre-commit --staged --redact --no-banner --config "$root/.gitleaks.toml" "$root"
