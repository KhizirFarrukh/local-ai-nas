# syntax=docker/dockerfile:1

# Development image (S01.1-T06, ADR-0006). Build from the repository root:
#   docker build -f deploy/Dockerfile.dev .
# Stages:
#   build    Go toolchain, downloads modules, builds the binary.
#   dev      the build stage running "go run" on the source mounted at /src
#            (used by deploy/compose.dev.yaml, so code changes need only a
#            restart, not an image rebuild).
#   runtime  debian:trixie-slim with only the binary, as a non-root user
#            (the default target; scanned by Trivy in CI).
# The release images come in S11.1.

FROM golang:1.27.1-trixie AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-X main.version=${VERSION}" \
    -o /out/local-ai-nas ./cmd/local-ai-nas

FROM build AS dev
ENV LOCALAINAS_STORAGE_ROOT=/data
EXPOSE 8080
CMD ["go", "run", "./cmd/local-ai-nas", "serve"]

FROM debian:trixie-slim AS runtime
RUN useradd --system --uid 10001 --user-group --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin nas \
    && mkdir /data && chown nas:nas /data
COPY --from=build /out/local-ai-nas /usr/local/bin/local-ai-nas
USER nas
ENV LOCALAINAS_STORAGE_ROOT=/data
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["local-ai-nas"]
CMD ["serve"]
